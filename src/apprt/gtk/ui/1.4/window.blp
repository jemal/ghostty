using Gtk 4.0;
using Adw 1;

template $GhosttyWindow: Adw.ApplicationWindow {
  styles [
    "window",
  ]

  close-request => $close_request();
  realize => $realize();
  notify::config => $notify_config();
  notify::fullscreened => $notify_fullscreened();
  notify::is-active => $notify_is_active();
  notify::maximized => $notify_maximized();
  notify::quick-terminal => $notify_quick_terminal();
  notify::scale-factor => $notify_scale_factor();
  notify::toolbar-visible => $notify_toolbar_visible();
  default-width: 800;
  default-height: 600;
  // GTK4 grabs F10 input by default to focus the menubar icon. We want
  // to disable this so that terminal programs can capture F10 (such as htop)
  handle-menubar-accel: false;

  content: Adw.TabOverview tab_overview {
    create-tab => $overview_create_tab();
    notify::open => $overview_notify_open();
    view: tab_view;
    enable-new-tab: true;
    inverted: bind template.tabs-inverted;
    // Disable the title buttons (close, maximize, minimize, ...)
    // *inside* the tab overview if CSDs are disabled.
    // We do spare the search button, though.
    show-start-title-buttons: bind template.decorated;
    show-end-title-buttons: bind template.decorated;

    Adw.ToolbarView toolbar {
      top-bar-style: bind template.toolbar-style;
      bottom-bar-style: bind template.toolbar-style;
      reveal-top-bars: bind template.toolbar-visible;
      reveal-bottom-bars: bind template.toolbar-visible;

      [top]
      Adw.HeaderBar {
        visible: bind template.headerbar-visible;

        title-widget: Adw.WindowTitle {
          title: bind $computed_title(template.config, template.title, template.title-override) as <string>;
          // Blueprint auto-formatter won't let me split this into multiple
          // lines. Let me explain myself. All parameters to a closure are used
          // as notifications to recompute the value of the closure. All
          // elements of a property chain are also subscribed to for changes.
          // This one long, ugly line saves us from manually building up this
          // massive notify chain in code.
          subtitle: bind $computed_subtitle(
            template.config,
            tab_view.selected-page.child as <$GhosttyTab>.active-surface as <$GhosttySurface>.pwd
            ) as <string>;
        };

        [start]
        Adw.SplitButton {
          clicked => $new_tab();
          icon-name: "tab-new-symbolic";
          tooltip-text: _("New Tab");
          dropdown-tooltip: _("New Split");
          menu-model: split_menu;
          can-focus: false;
          focus-on-click: false;
        }

        [end]
        Gtk.Box {
          spacing: 6;
          Gtk.Label header_status {
            styles ["session-status"]
            visible: false;
            ellipsize: end;
            single-line-mode: true;
            max-width-chars: 48;
          }
          Gtk.ToggleButton {
            icon-name: "view-grid-symbolic";
            tooltip-text: _("View Open Tabs");
            active: bind tab_overview.open bidirectional;
            can-focus: false;
            focus-on-click: false;
          }

          Gtk.MenuButton {
            notify::active => $notify_menu_active();
            icon-name: "open-menu-symbolic";
            menu-model: main_menu;
            tooltip-text: _("Main Menu");
            can-focus: false;
          }
        }
      }

      [top]
      Gtk.WindowHandle tab_strip_handle {
        visible: bind $tab_strip_visible(template.tabs-visible, template.tabs-autohide, tab_view.n-pages) as <bool>;
        Gtk.Box tab_strip_header {
          styles ["tab-strip-header"]

          Gtk.Box {
            orientation: horizontal;

            Gtk.WindowControls {
              side: start;
              visible: bind $native_tab_controls(template.titlebar-style, template.tabs-compact) as <bool>;
            }

            Gtk.Button session_button {
              styles ["flat", "session-selector"]
              valign: center;
              visible: bind template.session-enabled;
              action-name: "win.switch-session";
              focus-on-click: false;
              tooltip-text: bind template.session-name;
              focusable: true;

              child: Gtk.Box {
                Gtk.Image session_icon {
                  styles ["dim-label"]
                  icon-name: "ghostty-session-symbolic";
                  pixel-size: 18;
                }
                Gtk.Box {
                  orientation: vertical;
                  margin-start: 9;
                  valign: center;
                  // Always visible; long names remain bounded and ellipsized.
                  Gtk.Label session_label {
                    styles ["dim-label", "session-name"]
                    label: bind template.session-name;
                    ellipsize: end;
                    xalign: 0;
                    max-width-chars: bind $session_name_width(template.tabs-compact) as <int>;
                  }
                  Gtk.Label {
                    styles ["session-state"]
                    label: _("unsaved");
                    xalign: 0;
                    visible: bind template.session-saved inverted;
                  }
                }
              };
            }

            Adw.SplitButton {
              visible: bind $native_tab_controls(template.titlebar-style, template.tabs-compact) as <bool>;
              styles [
                "flat",
              ]

              clicked => $new_tab();
              icon-name: "tab-new-symbolic";
              tooltip-text: _("New Tab");
              dropdown-tooltip: _("New Split");
              menu-model: split_menu;
              can-focus: false;
              focus-on-click: false;
            }
          }

          Adw.TabBar tab_bar {
            hexpand: true;
            expand-tabs: bind template.tabs-wide;
            inverted: bind template.tabs-inverted;
            view: tab_view;
          }

          Gtk.ScrolledWindow compact_tab_scroll {
            styles ["compact-tab-scroll"]
            hexpand: true;
            hscrollbar-policy: external;
            vscrollbar-policy: never;
            visible: false;
            Gtk.Viewport {
              hscroll-policy: natural;
              Gtk.Box compact_tab_box {
                styles ["compact-tab-box"]
                spacing: 0;
                valign: center;
                halign: start;
              }
            }
          }

          Gtk.Box {
            orientation: horizontal;

            Gtk.Label session_status {
              styles ["session-status", "tabbar-status"]
              visible: false;
              valign: center;
              ellipsize: end;
              single-line-mode: true;
              xalign: 1;
              max-width-chars: 48;
            }

            // Compact tabs hide the native controls; these two remain.
            Gtk.Box {
              styles ["compact-window-tools"]
              orientation: horizontal;
              valign: center;
              visible: bind template.tabs-compact;

              Gtk.Button {
                styles ["flat"]
                action-name: "win.toggle-command-palette";
                tooltip-text: _("Command Palette");
                can-focus: false;
                focus-on-click: false;
                child: Gtk.Label {
                  label: "⌘";
                };
              }

              Gtk.Button {
                styles ["flat"]
                action-name: "win.new-tab";
                icon-name: "list-add-symbolic";
                tooltip-text: _("New Tab");
                can-focus: false;
                focus-on-click: false;
              }
            }

            Gtk.Box {
              orientation: horizontal;
              visible: bind $native_tab_controls(template.titlebar-style, template.tabs-compact) as <bool>;

              Gtk.ToggleButton {
                styles ["flat"]
                icon-name: "view-grid-symbolic";
                tooltip-text: _("View Open Tabs");
                active: bind tab_overview.open bidirectional;
                can-focus: false;
                focus-on-click: false;
              }

              Gtk.MenuButton {
                styles ["flat"]
                notify::active => $notify_menu_active();
                icon-name: "open-menu-symbolic";
                menu-model: main_menu;
                tooltip-text: _("Main Menu");
                can-focus: false;
              }

              Gtk.WindowControls {
                side: end;
              }
            }
          }
        }
      }

      Box {
        orientation: horizontal;

        // gtk-tabs-location = left: the tabs are a list at the side, with no
        // tab bar at the top. It shows and hides with the toolbars.
        Gtk.Box side_panel {
          styles ["tab-side"]
          orientation: vertical;
          width-request: 260;
          // Children expand inside the column; the column keeps its width.
          hexpand: false;
          visible: bind $side_panel_visible(template.config, template.toolbar-visible) as <bool>;

          Gtk.WindowHandle {
            Gtk.Box {
              styles ["tab-side-head"]
              orientation: horizontal;

              Gtk.Button {
                styles ["flat"]
                icon-name: "ghostty-sidebar-symbolic";
                action-name: "win.toggle-toolbar";
                tooltip-text: _("Hide Tabs");
                valign: center;
                can-focus: false;
                focus-on-click: false;
              }

              Gtk.Box {
                hexpand: true;
              }

              Gtk.Button {
                styles ["flat"]
                action-name: "win.toggle-command-palette";
                tooltip-text: _("Command Palette");
                valign: center;
                can-focus: false;
                focus-on-click: false;
                child: Gtk.Label {
                  label: "⌘";
                };
              }

              Gtk.Button {
                styles ["flat"]
                action-name: "win.new-tab";
                icon-name: "list-add-symbolic";
                tooltip-text: _("New Tab");
                valign: center;
                can-focus: false;
                focus-on-click: false;
              }
            }
          }

          Gtk.Button {
            styles ["flat", "tab-side-session"]
            halign: start;
            visible: bind template.session-enabled;
            action-name: "win.switch-session";
            tooltip-text: bind template.session-name;
            focus-on-click: false;
            child: Gtk.Label {
              label: bind template.session-name;
              ellipsize: end;
              xalign: 0;
            };
          }

          Gtk.ScrolledWindow side_tab_scroll {
            styles ["compact-tab-scroll"]
            vexpand: true;
            hscrollbar-policy: never;
            vscrollbar-policy: automatic;
            Gtk.Viewport {
              vscroll-policy: natural;
              Gtk.Box side_tab_box {
                styles ["side-tab-box"]
                orientation: vertical;
                spacing: 3;
                valign: start;
              }
            }
          }
        }

        Box {
          orientation: vertical;
          hexpand: true;

          $GhosttyDebugWarning {
            visible: bind template.debug;
          }

          Adw.ToastOverlay toast_overlay {
            Adw.TabView tab_view {
              notify::n-pages => $notify_n_pages();
              notify::selected-page => $notify_selected_page();
              close-page => $close_page();
              page-attached => $page_attached();
              page-detached => $page_detached();
              create-window => $tab_create_window();
              setup-menu => $setup_tab_menu();
              menu-model: tab_context_menu;
              shortcuts: none;
            }
          }
        }
      }
    }
  };
}

menu split_menu {
  item {
    label: _("Split Up");
    action: "win.split-up";
  }

  item {
    label: _("Split Down");
    action: "win.split-down";
  }

  item {
    label: _("Split Left");
    action: "win.split-left";
  }

  item {
    label: _("Split Right");
    action: "win.split-right";
  }
}

menu main_menu {
  section {
    item {
      label: _("Pick Theme…");
      action: "win.pick-theme";
    }
  }

  section {
    item {
      label: _("Copy");
      action: "win.copy";
    }

    item {
      label: _("Paste");
      action: "win.paste";
    }
  }

  section {
    item {
      label: _("Change Window Title…");
      action: "win.prompt-window-title";
    }

    item {
      label: _("New Window");
      action: "win.new-window";
    }

    item {
      label: _("Close Window");
      action: "win.close";
    }
  }

  section {
    item {
      label: _("View Open Tabs");
      action: "win.toggle-tab-overview";
    }

    item {
      label: _("Show/Hide Toolbar");
      action: "win.toggle-toolbar";
    }

    item {
      label: _("Change Tab Title…");
      action: "win.prompt-tab-title";
    }

    item {
      label: _("New Tab");
      action: "win.new-tab";
    }

    item {
      label: _("Close Tab");
      action: "win.close-tab";
      target: "this";
    }
  }

  section {
    submenu {
      label: _("Split");

      item {
        label: _("Change Title…");
        action: "win.prompt-surface-title";
      }

      item {
        label: _("Split Up");
        action: "win.split-up";
      }

      item {
        label: _("Split Down");
        action: "win.split-down";
      }

      item {
        label: _("Split Left");
        action: "win.split-left";
      }

      item {
        label: _("Split Right");
        action: "win.split-right";
      }
    }
  }

  section {
    item {
      label: _("Clear");
      action: "win.clear";
    }

    item {
      label: _("Reset");
      action: "win.reset";
    }
  }

  section {
    item {
      label: _("Command Palette");
      action: "win.toggle-command-palette";
    }

    item {
      label: _("Terminal Inspector");
      action: "win.toggle-inspector";
    }

    submenu {
      label: _("Config");

      item {
        label: _("Open Configuration in OS Editor");
        action: "app.open-config";
        target: "os-open";
      }

      item {
        label: _("Open Configuration in New Window");
        action: "app.open-config";
        target: "new-window";
      }

      item {
        label: _("Reload Configuration");
        action: "app.reload-config";
      }
    }
  }

  section {
    item {
      label: _("About Ghostty");
      action: "win.about";
    }

    item {
      label: _("Quit");
      action: "app.quit";
    }
  }
}

menu tab_context_menu {
  item {
    label: _("Change Tab Title…");
    action: "win.prompt-context-tab-title";
  }
}
