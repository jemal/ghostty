using Gtk 4.0;
using Adw 1;

template $GhostttySurfaceScrolledWindow: Adw.Bin {
  notify::surface => $notify_surface();
  notify::config => $refresh_decoration();
  map => $refresh_decoration();
  // The double-nesting is required due to a GTK bug where you can't
  // bind the first child of a builder layout. If you do, you get a double
  // dispose. Easiest way to see that is simply remove this and see the
  // GTK critical errors (and sometimes crashes).
  Adw.Bin {
    Gtk.Box pane_frame {
      orientation: vertical;
      overflow: hidden;

      Gtk.Box pane_header {
        styles ["pane-titlebar"]
        visible: false;
        // Shown on the first pane while the side tab list is hidden.
        Gtk.Button pane_lead {
          styles ["flat", "pane-lead"]
          icon-name: "ghostty-sidebar-symbolic";
          action-name: "win.toggle-toolbar";
          tooltip-text: _("Show Tabs");
          visible: false;
          valign: center;
          focus-on-click: false;
        }
        Gtk.Button pane_title_button {
          styles ["flat"]
          hexpand: true;
          focus-on-click: false;
          clicked => $focus_pane();
          child: Gtk.Box {
            spacing: 8;
            Gtk.Image pane_icon {
              styles ["pane-icon"]
              icon-name: "ghostty-program-terminal-symbolic";
              pixel-size: 15;
              valign: center;
            }
            Gtk.Label pane_title {
              label: _("Terminal");
              ellipsize: end;
              xalign: 0;
              hexpand: true;
            }
          };
        }
        Gtk.Box {
          styles ["pane-actions"]
          valign: center;
          Gtk.Button {
            styles ["flat"]
            icon-name: "ghostty-split-right-symbolic";
            tooltip-text: _("Split Right");
            focus-on-click: false;
            clicked => $split_right();
          }
          Gtk.Button {
            styles ["flat"]
            icon-name: "ghostty-split-down-symbolic";
            tooltip-text: _("Split Down");
            focus-on-click: false;
            clicked => $split_down();
          }
          Gtk.Button {
            styles ["flat"]
            icon-name: "ghostty-zoom-pane-symbolic";
            tooltip-text: _("Toggle Pane Zoom");
            focus-on-click: false;
            clicked => $zoom_pane();
          }
          Gtk.Button {
            styles ["flat"]
            icon-name: "window-close-symbolic";
            tooltip-text: _("Close terminal");
            focus-on-click: false;
            clicked => $close_pane();
          }
        }
      }
      Gtk.ScrolledWindow scrolled_window {
        vexpand: true;
        hscrollbar-policy: never;
        vscrollbar-policy: bind $scrollbar_policy(template.config) as <Gtk.PolicyType>;
      }
    }
  }
}
